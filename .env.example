# Copy to .env (or set these in your host's environment). Every value is optional; the defaults suit running locally.
# See the Configuration section of README.md for what each one does.

# --- Storage and analysis ---
# Where the SQLite database (and locally stored photos) live. Back this folder up.
CHESSCOACH_DATA=./data
# A postgresql:// URL stores everything in PostgreSQL instead (uv sync --extra postgres). Leave empty for SQLite.
DATABASE_URL=
# Scoresheet photos: local (under CHESSCOACH_DATA/uploads) or s3 (needs --extra aws, a bucket and AWS credentials).
CHESSCOACH_STORAGE=local
CHESSCOACH_S3_BUCKET=
AWS_REGION=
# Path to a Stockfish binary. Defaults to engines/stockfish/ in this project.
STOCKFISH_PATH=
# Search depth per position. 12 is a good balance (about 30-60 seconds per game).
CHESSCOACH_DEPTH=12
# 1 gives identical results every time. More threads are faster but results can vary slightly.
CHESSCOACH_THREADS=1

# --- Accounts and security ---
# Set to true once the site is served over HTTPS.
CHESSCOACH_COOKIE_SECURE=false
# Set to false to stop new accounts being created.
CHESSCOACH_ALLOW_SIGNUP=true
CHESSCOACH_SESSION_DAYS=30
# New accounts must confirm their email before signing in (needs working email).
CHESSCOACH_VERIFY_EMAIL=false
# Comma-separated admin accounts; each must confirm its email (Profile -> Send confirmation link).
CHESSCOACH_ADMIN_EMAILS=
# "Continue with Google": an OAuth client (Web application) from Google Cloud Console.
CHESSCOACH_GOOGLE_CLIENT_ID=
CHESSCOACH_GOOGLE_CLIENT_SECRET=
# "Continue with Apple" (needs --extra apple): Services ID, team ID, key ID and the .p8 key (write each line break as \n).
CHESSCOACH_APPLE_CLIENT_ID=
CHESSCOACH_APPLE_TEAM_ID=
CHESSCOACH_APPLE_KEY_ID=
CHESSCOACH_APPLE_PRIVATE_KEY=

# --- Email and contact ---
# log prints emails (with their links) to the console; ses sends them with Amazon SES (needs --extra aws).
CHESSCOACH_MAIL_BACKEND=log
CHESSCOACH_MAIL_FROM="Chess Varsity <no-reply@localhost>"
# The site's public address for links in emails (required with ses), e.g. https://dukesmateai.com
CHESSCOACH_PUBLIC_URL=
# Where feedback, contact messages and reports are emailed. Empty: they are only saved.
CHESSCOACH_FEEDBACK_TO=
# Shown publicly on the contact page. Empty: the page shows only the form.
CHESSCOACH_CONTACT_EMAIL=
