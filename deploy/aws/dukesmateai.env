# Settings for the Dukes Mate AI service on the EC2 server (installed at /etc/dukesmateai/app.env).
# No secrets here: the database password is read from AWS Secrets Manager each time the app starts.

AWS_REGION=us-east-2
# Secrets Manager secret holding {"username", "password", "dbname"} for the app's database user.
DB_SECRET_ID=DukesMateAI/app-db
# RDS endpoint (private; only the app server's security group can reach port 5432).
DB_HOST=dukesmateai-db.clkcymyc4adv.us-east-2.rds.amazonaws.com
DB_PORT=5432
# TLS to RDS, verified against the AWS RDS certificate bundle.
DB_SSLROOTCERT=/opt/dukesmateai/rds-ca.pem

CHESSCOACH_DATA=/var/lib/dukesmateai
STOCKFISH_PATH=/usr/games/stockfish
CHESSCOACH_DEPTH=12
CHESSCOACH_THREADS=1
# true once Caddy serves the site over HTTPS.
CHESSCOACH_COOKIE_SECURE=true
CHESSCOACH_ALLOW_SIGNUP=true
CHESSCOACH_SESSION_DAYS=30

# Email (Amazon SES through the instance's IAM role). Verification stays off until SES production access is
# granted (the sandbox only reaches verified addresses); then set CHESSCOACH_VERIFY_EMAIL=true.
CHESSCOACH_MAIL_BACKEND=ses
CHESSCOACH_VERIFY_EMAIL=false
CHESSCOACH_MAIL_FROM="Chess Varsity <no-reply@chessvarsity.com>"
CHESSCOACH_PUBLIC_URL=https://dukesmateai.com
# Feedback and contact-form messages go here.
# Real addresses are set on the server only (kept out of the public repository).
CHESSCOACH_FEEDBACK_TO=owner@example.com
# Who may open the admin dashboard (comma-separated). The account's email must also be confirmed.
CHESSCOACH_ADMIN_EMAILS=owner@example.com
# Shown publicly on the contact page; leave empty to show only the form.
CHESSCOACH_CONTACT_EMAIL=
# Google / Apple sign-in keys live in this Secrets Manager secret (see DEPLOYMENT.md). Missing: those buttons are hidden.
OAUTH_SECRET_ID=DukesMateAI/oauth
# Scoresheet photos: kept in the private bucket (Standard-IA storage class), under scoresheets/.
CHESSCOACH_STORAGE=s3
CHESSCOACH_S3_BUCKET=s3-dukesmateai

# The app listens only on localhost; Caddy is the public entry point.
APP_HOST=127.0.0.1
APP_PORT=8000

# Nightly pg_dump destination.
BACKUP_BUCKET=s3-dukesmateai
